# Copy to backend/.env. Generate secrets; never use these placeholders.
APP_ENV=development
SECRET_KEY=replace-with-output-of-python-secrets-token-hex-32
DATABASE_URL=sqlite+aiosqlite:///./studymind.sqlite
API_ORIGIN=http://localhost:8000
WEB_ORIGIN=http://localhost:5173
# Required for actual generation. Select an active model in your Anthropic account.
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=
REQUIRE_EMAIL_VERIFICATION=true
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM=
GENERATION_DAILY_LIMIT=20
GENERATION_GLOBAL_DAILY_LIMIT=200
GENERATION_CONCURRENCY=2
# Optional: exactly 64 hex characters; only trust an edge that overwrites both headers.
PROXY_TOKEN=
